# Copy to .env and replace local passwords and SECRET_KEY before starting.
SECRET_KEY=replace-with-a-random-development-key
# Optional separate JWT signing key; empty uses SECRET_KEY.
JWT_SIGNING_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver,backend

# PostgreSQL admin is used only for initial provisioning.
POSTGRES_USER=flowgic_admin
POSTGRES_PASSWORD=replace-with-a-random-admin-password
DB_NAME=flowgic
DB_USER=flowgic_app
DB_PASSWORD=replace-with-a-random-app-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_PUBLISHED_PORT=5432

# Separate non-superuser account with CREATEDB for disposable pytest databases.
DB_TEST_USER=flowgic_test
DB_TEST_PASSWORD=replace-with-a-random-test-password
DB_TEST_NAME=test_flowgic

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PUBLISHED_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Development default does not send real email.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Flowgic <noreply@localhost>
