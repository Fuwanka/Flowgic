      "RegistrationIn": {
        "additionalProperties": false,
        "properties": {
          "company_name": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Company Name",
            "type": "string"
          },
          "company_type": {
            "default": "logistics",
            "enum": [
              "logistics",
              "manufacturer",
              "retail",
              "government"
            ],
            "title": "Company Type",
            "type": "string"
          },
          "email": {
            "format": "email",
            "maxLength": 254,
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Full Name",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ],
            "default": "manager"
          }
